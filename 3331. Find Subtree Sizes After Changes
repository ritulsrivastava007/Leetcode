import java.util.*;
class Solution {
    public int[] findSubtreeSizes(int[] parent, String s) {
        int n = parent.length;
        List<List<Integer>> adj = new ArrayList<>();
        for (int i = 0; i < n; i++) {
            adj.add(new ArrayList<>());
        }
        for (int i = 1; i < n; i++) {
            adj.get(parent[i]).add(i);
        }
        int[] newParent = parent.clone();
        Map<Character, Integer> last = new HashMap<>();
        dfsParent(0, adj, s, last, newParent);
        List<List<Integer>> newAdj = new ArrayList<>();

        for (int i = 0; i < n; i++) {
            newAdj.add(new ArrayList<>());
        }
        for (int i = 1; i < n; i++) {
            newAdj.get(newParent[i]).add(i);
        }

        int[] answer = new int[n];
        dfsSize(0, newAdj, answer);
        return answer;
    }

    private void dfsParent(int node, List<List<Integer>> adj, String s, Map<Character, Integer> last, int[] newParent) {

        char ch = s.charAt(node);
        Integer prev = last.get(ch);
        if (prev != null) {
            newParent[node] = prev;
        }
        last.put(ch, node);

        for (int child : adj.get(node)) {
            dfsParent(child, adj, s, last, newParent);
        }
        if (prev == null) {
            last.remove(ch);
        } else {
            last.put(ch, prev);
        }
    }

    private int dfsSize(int node, List<List<Integer>> adj, int[] answer) {
        int size = 1;

        for (int child : adj.get(node)) {
            size += dfsSize(child, adj, answer);
        }
        answer[node] = size;
        return size;
    }
}
