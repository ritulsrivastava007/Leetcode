import java.util.*;

class Solution {
    public int maximumSaleItems(int[][] items, int budget) {
        int n = items.length;

        int[] freq = new int[n + 1];

        for (int[] item : items) {
            freq[item[0]]++;
        }

        int[] divisible = new int[n + 1];

        for (int f = 1; f <= n; f++) {
            for (int j = f; j <= n; j += f) {
                divisible[f] += freq[j];
            }
        }

        int minPrice = Integer.MAX_VALUE;

        for (int[] item : items) {
            minPrice = Math.min(minPrice, item[1]);
        }

        Integer[] order = new Integer[n];

        for (int i = 0; i < n; i++) {
            order[i] = i;
        }

        Arrays.sort(order, (a, b) ->
            Integer.compare(items[a][1], items[b][1])
        );

        long remaining = budget;
        long bonus = 0;

        for (int idx : order) {
            int factor = items[idx][0];
            int price = items[idx][1];

            if (price > 2L * minPrice) {
                break;
            }

            long capacity = divisible[factor] - 1L;

            long buy = Math.min(capacity, remaining / price);

            bonus += buy;
            remaining -= buy * price;
        }

        long normal = remaining / minPrice;

        return (int) (2 * bonus + normal);
    }
}