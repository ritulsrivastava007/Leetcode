class Solution {
    public int maxLength(int[] nums) {
        int n = nums.length, ans = 1;

        for (int i = 0; i < n; i++) {
            long product= 1, gcd =0, lcm= 1;

            for (int j = i; j < n; j++) {
                gcd = gcd(gcd, nums[j]);
                lcm = lcm(lcm, nums[j]);
                product *= nums[j];

                if (product == lcm * gcd) {
                    ans=Math.max(ans,j-i+1);
                }
            }
        }
        return ans;
    }

    private long gcd(long a, long b) {
        while (b != 0) {
            long temp = b;
            b = a % b;
            a = temp;
        }
        return a;
    }
    private long lcm(long a, long b) {
        return (a / gcd(a, b)) * b;
    }
}