class Solution {
    public int numberOfSets(int n, int k) {
        long MOD = 1000000007L;
        int N = n + k - 1, R = 2 * k;
        if (R > N) return 0;
        long num = 1, deno = 1;
        for (int i = 1; i <= R; i++) {
            num= num* (N -R +i) %MOD;
            deno= deno* i%MOD;
        }
        return (int)(num*modInverse(deno, MOD)% MOD);
    }
    private long modInverse(long a, long mod) {
        return power(a, mod - 2, mod);
    }
    private long power(long a, long b, long mod) {
        long result = 1;
        while (b > 0) {
            if ((b & 1) == 1) {
                result = result * a % mod;
            }
            a = a * a % mod;
            b >>= 1;
        }
        return result;
    }
}
