import java.util.*;

class Solution {
    public int minimumSumSubarray(List<Integer> nums, int l, int r) {
        int n = nums.size();

        long[] prefix = new long[n + 1];

        for (int i = 0; i < n; i++) {
            prefix[i + 1] = prefix[i] + nums.get(i);
        }

        TreeMap<Long, Integer> map = new TreeMap<>();

        long ans = Long.MAX_VALUE;

        for (int i = l; i <= n; i++) {

            // Add valid starting prefix
            long add = prefix[i - l];
            map.put(add, map.getOrDefault(add, 0) + 1);

            // Remove expired prefix
            int removeIndex = i - r - 1;

            if (removeIndex >= 0) {
                long remove = prefix[removeIndex];
                int count = map.get(remove);

                if (count == 1) {
                    map.remove(remove);
                } else {
                    map.put(remove, count - 1);
                }
            }

            // Largest prefix sum smaller than current prefix
            Long candidate = map.lowerKey(prefix[i]);

            if (candidate != null) {
                ans = Math.min(ans, prefix[i] - candidate);
            }
        }

        return ans == Long.MAX_VALUE ? -1 : (int) ans;
    }
}
