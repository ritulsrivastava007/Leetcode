import java.util.*;
class Solution {
    public int scoreOfParentheses(String s) {
        Stack<Integer> stack = new Stack<>();
        int score = 0;

        for (char ch : s.toCharArray()) {
            if (ch == '(') {
                stack.push(score);
                score = 0;
            } else {
                int inner = score;
                score = stack.pop();

                if (inner == 0) {
                    score += 1;
                } else {
                    score += 2 * inner;
                }
            }
        }

        return score;
    }
}
