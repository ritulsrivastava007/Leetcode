class Solution {
    public String removeOuterParentheses(String s) {
        StringBuilder ans = new StringBuilder();
        int sum = 0;

        for (char c : s.toCharArray()) {
            if (c == '(') {
                if (sum > 0) {
                    ans.append(c);
                }
                sum++;
            } else {
                sum--;
                if (sum > 0) {
                    ans.append(c);
                }
            }
        }

        return ans.toString();
    }
}
