class Solution {
    public long countCommas(long n) {
        long[] threshold = {1_000L, 1_000_000L, 1_000_000_000L, 1_000_000_000_000L, 1_000_000_000_000_000L, 1_000_000_000_000_000_000L};
        long ans = 0;
        for (long t : threshold) {
            if (n >= t) {
                ans += (n - t + 1);
            }
        }
        return ans;
    }
}
