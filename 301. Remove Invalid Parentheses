import java.util.*;
class Solution {
    public List<String> removeInvalidParentheses(String s) {
        int l = 0, r = 0;
        for(char c :s.toCharArray()){
            if (c == '(') {
                l++;
            }else if (c == ')') {
                if (l > 0) {
                    l--;
                }else {
                    r++;
                }
            }
        
        Set<String> result = new HashSet<>();
        backtrack(s,0,0,l,r,new StringBuilder(),result);
        return new ArrayList<>(result);
    
    private void backtrack(String s,int index,int balance,int l,int r,StringBuilder current,Set<String> result){
        if(index == s.length()) {
            if (balance==0 && l==0 && r==0){
                result.add( current.toString() );
            }
            return;
        
        char c = s.charAt(index);
        if (c == '(') {
            if(l> 0){
                backtrack(s,index+1, balance,l- 1,r,current, result);
            
            current.append(c);
            backtrack(s,index+ 1,balance+1, l,r,current, result);
            current.deleteCharAt( current.length() - 1 );
        }else if (c == ')'){
            if(r> 0){
                backtrack(s,index+1,balance, l,r -1,current, result);
            
            if (balance > 0) {
                current.append(c);
                backtrack(s,index+1,balance - 1, l,r,current, result);
                current.deleteCharAt( current.length() - 1 );
            }
        } else {
            current.append(c);
            backtrack(s,index +1,balance, l,r,current, result);
            current.deleteCharAt( current.length() - 1 );
        }
    }
}
